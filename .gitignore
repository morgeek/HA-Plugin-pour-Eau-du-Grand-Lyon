# =============================================================================
# .gitignore — le dépôt GitHub contient l'intégration et de quoi la distribuer et
# la valider : custom_components/eau_grand_lyon/, hacs.json, README, CHANGELOG,
# docs/screenshots/, blueprints/, lovelace/, tests/ + pytest.ini, .github/. Seul
# l'outillage purement local ci-dessous reste hors du suivi Git.
# =============================================================================

# --- Outillage purement local (hors dépôt GitHub) ---
smoke_tests/
.pre-commit-config.yaml
AGENTS.md

# --- OS cruft ---
.DS_Store
custom_components/eau_grand_lyon/.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- AI tool local state (personal, not shared) ---
.continue
.claude
.cursor/
.aider*
CLAUDE.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
*.spec

# --- Virtual environments ---
.venv/
venv/
env/
.python-version

# --- Test / coverage / type-check / lint caches ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/

# --- Secrets / credentials (never commit) ---
.env
.env.*
secrets.yaml
*.pem
*.key
credentials.json

# --- Home Assistant runtime artifacts (in case the repo is tested inside a HA config) ---
.storage/
.cloud/
.HA_VERSION
home-assistant.log*
home-assistant_v2.db*
*.db
*.db-*
deps/
tts/

# --- Build / packaging / misc ---
node_modules/
*.bak
*.orig
*.rej
*.tmp
